"        function finishPomodoro() {",
"            if (pomodoroTimerId) clearInterval(pomodoroTimerId);",
"            pomodoroTimerId = null;",
"            pomodoroRunning = false;",
"            const s = getPomodoroState();",
"            s.count += 1;",
"            s.rounds += 1;",
"            s.minutes += 25;",
"            savePomodoroState(s);",
"            // v50：番茄时长自动累加到健康页「专注」指标（25 分钟 = 0.42h）",
"            let healthUpdated = false;",
"            try {",
"                var h = getHealth();",
"                var addHours = POMODORO_FOCUS_SECONDS / 3600;",
"                h.daily.focusHours = Math.round(((h.daily.focusHours || 0) + addHours) * 100) / 100;",
"                // 直接写本地，避免 saveHealth 内部再单独推送一次",
"                localStorage.setItem(STORAGE_KEY_HEALTH, JSON.stringify(h));",
"                healthUpdated = true;",
"            } catch (eHealth) {",
"                console.error('[finishPomodoro] 同步专注时长失败:', eHealth);",
"            }",
"            if (healthUpdated && typeof renderHealth === 'function') {",
"                try { renderHealth(); } catch (eRender) {}",
"            }",
"            // 番茄钟与健康数据一起推送一次",
"            if (typeof pushToCloud === 'function' && syncEnabled) pushToCloud().catch(function() {});",
"            pomodoroRemaining = POMODORO_FOCUS_SECONDS;",
"            renderPomodoro();",
"            if (typeof showToast === 'function') showToast('番茄钟完成，休息 5 分钟 ☕', 'success');",
"        }"
]}
]