"                // v50 新增：番茄钟按\"同一天取较大值\"合并，避免本地与 GitHub Pages 多端互相覆盖",
"                if (k === 'media_workflow_pomodoro') {",
"                    try {",
"                        var pomoToday = getTodayDate();",
"                        var localP = null;",
"                        try {",
"                            var localPRaw = localStorage.getItem(k);",
"                            localP = localPRaw ? JSON.parse(localPRaw) : null;",
"                        } catch (eLp) { localP = null; }",
"                        var remoteP = null;",
"                        try { remoteP = (typeof val === 'string') ? JSON.parse(val) : val; } catch (eRp) { remoteP = null; }",
"                        if (!remoteP || remoteP.date !== pomoToday) return; // 云端不是今天的记录，忽略",
"                        var localSameDay = (localP && localP.date === pomoToday) ? localP : null;",
"                        var mergedP = {",
"                            date: pomoToday,",
"                            count: Math.max(localSameDay ? (localSameDay.count || 0) : 0, remoteP.count || 0),",
"                            minutes: Math.max(localSameDay ? (localSameDay.minutes || 0) : 0, remoteP.minutes || 0),",
"                            rounds: Math.max(localSameDay ? (localSameDay.rounds || 0) : 0, remoteP.rounds || 0)",
"                        };",
"                        localStorage.setItem(k, JSON.stringify(mergedP));",
"                        console.log('[restoreFromCloudData] pomodoro 合并：本地', localSameDay ? localSameDay.count : 0,",
"                            '+ 云端', remoteP.count || 0, '→', mergedP.count, '个番茄');",
"                        return;",
"                    } catch (ePomo) {",
"                        console.error('[restoreFromCloudData] pomodoro 合并异常:', ePomo);",
"                        return;",
"                    }",
"                }",
"                // v50 新增：主题偏好只在新设备（本地无记录）时继承云端，避免多端来回切换",
"                if (k === 'media_workflow_dark_mode') {",
"                    try {",
"                        if (localStorage.getItem(k) === null) {",
"                            var isDarkCloud = (val === true || val === 'true');",
"                            localStorage.setItem(k, isDarkCloud ? 'true' : 'false');",
"                            document.body.classList.toggle('dark-mode', isDarkCloud);",
"                            if (typeof updateThemeToggleBtn === 'function') updateThemeToggleBtn();",
"                        }",
"                        return;",
"                    } catch (eDark) {",
"                        return;",
"                    }",
"                }"
