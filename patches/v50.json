{"op":"insertAfter","line":14354,"verify":"        }","lines":[
"",
"        // ============ v50 健康日历（长期状态） ============",
"        var healthCalOffset = 0;      // 0 = 本月，-1 = 上月",
"        var healthCalSelected = null; // 选中的日期 yyyy-mm-dd",
"",
"        // 计算某天的达标数（0-4），无记录返回 -1",
"        function _healthDayLevel(rec, goals) {",
"            if (!rec) return -1;",
"            if (!(rec.sleepHours || rec.focusHours || rec.standSteps || rec.screenHours)) return -1;",
"            var pass = 0;",
"            if ((rec.sleepHours || 0) >= goals.sleepHours) pass++;",
"            if ((rec.focusHours || 0) >= goals.focusHours) pass++;",
"            if ((rec.standSteps || 0) >= goals.standSteps) pass++;",
"            if ((rec.screenHours || 0) > 0 && (rec.screenHours || 0) <= goals.screenHours) pass++;",
"            return pass;",
"        }",
"",
"        function shiftHealthCalendar(delta) {",
"            healthCalOffset += delta;",
"            if (healthCalOffset > 0) healthCalOffset = 0; // 不看未来月份",
"            healthCalSelected = null;",
"            renderHealthCalendar();",
"        }",
"",
"        function resetHealthCalendar() {",
"            healthCalOffset = 0;",
"            healthCalSelected = null;",
"            renderHealthCalendar();",
"        }",
"",
"        function selectHealthCalendarDay(ds) {",
"            healthCalSelected = (healthCalSelected === ds) ? null : ds;",
"            renderHealthCalendar();",
"        }",
"",
"        // v50：快速跳转到指定日期（自动切月 + 选中该日）",
"        function jumpHealthCalendar(ds) {",
"            if (!ds || ds.split('-').length !== 3) return;",
"            var p = ds.split('-');",
"            var ty = parseInt(p[0], 10), tm = parseInt(p[1], 10) - 1;",
"            if (isNaN(ty) || isNaN(tm)) return;",
"            var now = new Date();",
"            var delta = (ty - now.getFullYear()) * 12 + (tm - now.getMonth());",
"            if (delta > 0) {",
"                // 未来月份没有记录，回到本月并清除选中",
"                healthCalOffset = 0;",
"                healthCalSelected = null;",
"            } else {",
"                healthCalOffset = delta;",
"                healthCalSelected = ds;",
"            }",
"            renderHealthCalendar();",
"        }",
"",
"        function renderHealthCalendar() {",
"            var grid = document.getElementById('healthCalGrid');",
"            if (!grid) return;",
"            var h = getHealth();",
"            var G = h.goals, D = h.daily;",
"            var todayStr = _todayStr();",
"",
"            var base = new Date();",
"            base.setDate(1);",
"            base.setMonth(base.getMonth() + (healthCalOffset || 0));",
"            var y = base.getFullYear(), m = base.getMonth();",
"",
"            var titleEl = document.getElementById('healthCalTitle');",
"            if (titleEl) titleEl.textContent = y + '年' + (m + 1) + '月';",
"",
"            var recMap = {};",
"            h.history.forEach(function(r) { if (r && r.date) recMap[r.date] = r; });",
"            recMap[todayStr] = D;",
"",
"            var firstWd = new Date(y, m, 1).getDay();     // 0 = 周日",
"            var startOffset = (firstWd + 6) % 7;           // 周一开头",
"            var daysInMonth = new Date(y, m + 1, 0).getDate();",
"",
"            var html = '';",
"            for (var i = 0; i < startOffset; i++) html += '<div class=\"health-cal-cell empty\"></div>';",
"            for (var day = 1; day <= daysInMonth; day++) {",
"                var ds = y + '-' + String(m + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');",
"                var rec = recMap[ds];",
"                var lvl = _healthDayLevel(rec, G);",
"                var cls = 'health-cal-cell';",
"                if (ds === todayStr) cls += ' today';",
"                if (lvl >= 0) cls += ' has-data lvl-' + lvl;",
"                if (healthCalSelected === ds) cls += ' selected';",
"                html += '<div class=\"' + cls + '\"' + (lvl >= 0 ? ' onclick=\"selectHealthCalendarDay(\\'' + ds + '\\')\"' : '') + '>' +",
"                    '<span class=\"d\">' + day + '</span><span class=\"lvl\"></span></div>';",
"            }",
"            grid.innerHTML = html;",
"",
"            var jumpEl = document.getElementById('healthCalJump');",
"            if (jumpEl) jumpEl.value = healthCalSelected || '';",
"",
"            // 月度汇总",
"            var monthRecs = 0, monthPass = 0;",
"            h.history.forEach(function(r) {",
"                if (r && r.date && r.date.indexOf(y + '-' + String(m + 1).padStart(2, '0')) === 0) {",
"                    var l = _healthDayLevel(r, G);",
"                    if (l >= 0) { monthRecs++; monthPass += l; }",
"                }",
"            });",
"            if (todayStr.indexOf(y + '-' + String(m + 1).padStart(2, '0')) === 0) {",
"                var lt = _healthDayLevel(D, G);",
"                if (lt >= 0) { monthRecs++; monthPass += lt; }",
"            }",
"            renderHealthCalendarDetail(monthRecs, monthPass);",
"        }",
"",
"        function renderHealthCalendarDetail(monthRecs, monthPass) {",
"            var box = document.getElementById('healthCalDetail');",
"            if (!box) return;",
"            var h = getHealth();",
"            var G = h.goals, D = h.daily;",
"            var todayStr = _todayStr();",
"",
"            var summary = '';",
"            if (typeof monthRecs === 'number') {",
"                summary = monthRecs > 0",
"                    ? '本月已记录 ' + monthRecs + ' 天 · 平均达标 ' + (monthPass / monthRecs).toFixed(1) + '/4'",
"                    : '本月暂无记录';",
"            }",
"",
"            if (!healthCalSelected) {",
"                box.innerHTML = '<div class=\"health-cal-empty\">' + summary + '<br>点击日历中有颜色的日期查看当日明细</div>';",
"                return;",
"            }",
"",
"            var ds = healthCalSelected;",
"            var rec = (ds === todayStr) ? D : h.history.find(function(x) { return x.date === ds; });",
"            if (!rec) {",
"                box.innerHTML = '<div class=\"health-cal-empty\">该日期暂无记录</div>';",
"                return;",
"            }",
"",
"            var rows = [",
"                { label: '睡眠', value: rec.sleepHours || 0, goal: G.sleepHours, unit: 'h', invert: false },",
"                { label: '专注', value: rec.focusHours || 0, goal: G.focusHours, unit: 'h', invert: false },",
"                { label: '步数', value: Math.round(rec.standSteps || 0), goal: G.standSteps, unit: '', invert: false },",
"                { label: '屏幕', value: rec.screenHours || 0, goal: G.screenHours, unit: 'h', invert: true }",
"            ];",
"            var parts = ds.split('-');",
"            var head = parseInt(parts[1], 10) + '月' + parseInt(parts[2], 10) + '日' +",
"                (ds === todayStr ? ' · 今天' : '') +",
"                '<em>达标 ' + _healthDayLevel(rec, G) + '/4</em>';",
"",
"            var rowsHtml = '';",
"            rows.forEach(function(r) {",
"                var ok = r.invert ? (r.value > 0 && r.value <= r.goal) : (r.value >= r.goal);",
"                var valTxt = r.unit === '' ? r.value.toLocaleString() : r.value + r.unit;",
"                var goalTxt = r.unit === '' ? r.goal.toLocaleString() : r.goal + r.unit;",
"                rowsHtml += '<div class=\"health-cal-detail-row\"><span>' + r.label + '</span>' +",
"                    '<b>' + valTxt + '</b><span style=\"font-size:11px;color:var(--text-muted)\">/ ' + goalTxt + '</span>' +",
"                    '<span class=\"tag ' + (ok ? 'ok' : 'bad') + '\">' + (ok ? '达标' : '未达标') + '</span></div>';",
"            });",
"",
"            box.innerHTML = '<div class=\"health-cal-detail-head\">' + head + '</div>' + rowsHtml +",
"                (summary ? '<div class=\"health-cal-empty\" style=\"margin-top:8px\">' + summary + '</div>' : '');",
"        }"
]},
